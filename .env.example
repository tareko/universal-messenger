# --- Server ---
PORT=8317

# --- voip.ms provider (https://voip.ms/m/api.php) ---
# Your voip.ms login email and a dedicated API password (NOT your portal password).
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=
# ISO country code used to normalize local numbers without a country code.
VOIPMS_DEFAULT_COUNTRY=US
# IANA timezone voip.ms reports message dates in (your account timezone).
VOIPMS_TIMEZONE=America/Toronto
# Optional: restrict/order DIDs shown (comma-separated). Empty = all SMS-capable DIDs.
VOIPMS_DIDS=
# Polling interval (ms). 20000 = responsive; raise to ~120000 once the webhook is live.
VOIPMS_POLL_INTERVAL_MS=20000

# --- Nextcloud CardDAV (contacts) ---
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
# Use a Nextcloud App Password, NOT your main account password.
NEXTCLOUD_PASSWORD=
NEXTCLOUD_ADDRESSBOOK=
# How often to refresh contacts (ms). 1800000 = 30 min.
CONTACTS_SYNC_INTERVAL_MS=1800000

# --- Inbound webhook (voip.ms → this app) ---
# Random secret appended to the voip.ms callback URL as ?key=. Generate with:
#   openssl rand -hex 32
WEBHOOK_KEY=
# Public URL the voip.ms callback points at (e.g. https://sms.example.com).
PUBLIC_WEBHOOK_URL=

# --- Push (ntfy / UnifiedPush) ---
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# --- App auth (optional) ---
# If set, /api and /events require `Authorization: Bearer <token>` (SSE accepts
# ?token= instead, since EventSource can't set headers). If blank (default),
# the backend is open and relies on the network (e.g. VPN) for access.
APP_API_TOKEN=

# --- Storage ---
DB_PATH=./data/app.db
